test <- bind_rows(all_results)
View(test)
clinical_outcomes <- c("moca_total", "moca_total_adj", "seman_flu_score",
"updrs_i", "updrs_ii", "updrs_iii", "updrs_iv",
"pdq8_total", "ess_total", "eq5d_index",
"rbd_total", "gcsi_total", "leeds_anx_total", "hoehn_and_yahr_stage", "nmss_sleep")
#Function to run the mixed-effect model across all module eigenproteins from clinical variables of interest
all_results <- list()
all_models <- list()
for(outcome in clinical_outcomes) {
clin_lmer <- list()
clin_results <- list()
for(i in module_colours) {
#Defining the model formula
formula <- as.formula(paste0(outcome, "~", i, "*visit_number + age_at_visit + gender + (1|PatientId)"))
#Running the mixed-effect model
clin_lmer[[i]] <- lmer(formula, data = input_RM_long)
#Extracting the statistics from the main effect (module eigenprotein)
main <- summary(clin_lmer[[i]])$coefficients %>%
as.data.frame() %>%
rownames_to_column(var = "term") %>%
filter(term == i)
#Running ANOVA on the interaction term (since visit_number has 3 factor-level time points [1,4,7])
interaction <- anova(clin_lmer[[i]], type = 3) %>%
as.data.frame() %>%
rownames_to_column(var = "term") %>%
filter(term == paste0(i, ":visit_number"))
#Building the results table
clin_results[[i]] <- data.frame(
clin_var = outcome,
module = i,
beta = main$Estimate,
se = main$`Std. Error`,
t = main$`t value`,
p_main = main$`Pr(>|t|)`,
F = interaction$`F value`,
p_interaction = interaction$`Pr(>F)`
)
}
all_models[[outcome]] <- clin_lmer
all_results[[outcome]] <- bind_rows(clin_results)
}
#Summary table with adjusted p-values
all_results <- bind_rows(all_results) %>%
mutate(
FDR_main = p.adjust(p_main, method = "BH"),
FDR_interaction = p.adjust(p_interaction, method = "BH")
)
View(all_results)
View(all_results)
#Saving the output
write.csv(all_results, "trackingPD_lmer.csv", row.names = F)
